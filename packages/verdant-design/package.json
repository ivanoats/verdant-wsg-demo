{
  "name": "@sustainablewebsites/verdant-design",
  "version": "0.1.1",
  "description": "A Green Web Design System with Sustainable Defaults following W3C WSG guidelines",
  "type": "module",
  "license": "ISC",
  "author": "Ivan Storck",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ivanoats/verdant-wsg-demo.git",
    "directory": "packages/verdant-design"
  },
  "homepage": "https://github.com/ivanoats/verdant-wsg-demo/blob/main/docs/INSTALL.md",
  "keywords": [
    "pandacss",
    "panda-preset",
    "design-system",
    "sustainability",
    "wsg",
    "accessibility"
  ],
  "exports": {
    ".": {
      "types": "./src/preset.d.ts",
      "import": "./src/preset.mjs"
    },
    "./tokens": {
      "types": "./src/tokens.d.ts",
      "import": "./src/tokens.mjs"
    },
    "./theme": {
      "types": "./src/theme.d.ts",
      "import": "./src/theme.mjs"
    },
    "./theme-toggle.js": "./src/theme-toggle.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "peerDependencies": {
    "@pandacss/dev": ">=1.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
